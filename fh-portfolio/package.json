{
  "name": "fh-port",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000",
    "build": "npm run build:inner && npm run build:stitch && npm run build:shell",
    "build:inner": "npm --prefix ../fh-portfolio-inner run build -- --base=/inner/",
    "build:stitch": "node ../scripts/stitch-inner.mjs",
    "build:shell": "tsc -b && vite build",
    "start": "vite preview --port=3000",
    "lint": "eslint .",
    "preview": "vite preview --port=3000",
    "optimize-models": "node scripts/optimize-models.mjs",
    "optimize-models:medium": "node scripts/optimize-models-medium.mjs",
    "optimize-models:desktop": "node scripts/optimize-models-desktop.mjs",
    "optimize-textures": "node scripts/optimize-textures.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.3.0",
    "@react-three/fiber": "^9.1.4",
    "@types/three": "^0.177.0",
    "lil-gui": "^0.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@gltf-transform/cli": "^4.3.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0"
  }
}
